                },
                {
                  "kind": "text",
                  "text": "repo, workflow"
                }
              ]
            },
            "glyph": {
              "kind": "account:github"
            }
          }
        },
        {
          "row": {
            "id": "macbook-pro/claude",
            "mark": "ok",
            "label": "Claude",
            "detail": {
              "kind": "list",
