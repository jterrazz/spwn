            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "from the password Claude token"
                }
              ]
            },
            "glyph": {
              "kind": "account:claude"
            },
            "mac": "linux-1",
            "menu": [
              "title:linux-1/claude",
              "remove-grant:linux-1/claude@menu"
            ]
          }
        },
        {
          "row": {
            "id": "linux-1/gh",
            "mark": "ok",
            "label": "GitHub",
            "cells": [
              {
                "kind": "text",
                "text": "granted"
              }
            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "from the password GitHub token"
                }
              ]
            },
            "glyph": {
              "kind": "account:github"
            },
            "mac": "linux-1",
            "menu": [
              "title:linux-1/gh",
              "remove-grant:linux-1/gh@menu"
            ]
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 2
        }
      ],
      "card": "flush"
    },
    {
      "id": "on:linux-3",
      "title": "On linux-3",
      "caption": [
        {
          "kind": "text",
          "text": "1"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "linux-3/gh",
            "mark": "ok",
            "label": "GitHub",
            "cells": [
              {
                "kind": "text",
                "text": "granted"
              }
            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "from the password GitHub token"
                }
              ]
            },
            "glyph": {
              "kind": "account:github"
            },
            "mac": "linux-3"
          }
        }
      ],
