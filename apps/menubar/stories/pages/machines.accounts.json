          "mark": "ok",
          "n": 1
        }
      ],
      "card": "flush"
    },
    {
      "id": "silent",
      "title": "Not read",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "macbook-air",
            "mark": "unknown",
            "label": "macbook-air",
            "short": "macbook-air",
            "cells": [
              {
                "kind": "text",
                "text": "macbook-air does not answer"
              }
            ],
            "reason": "unreachable"
          }
        }
      ],
      "uncounted": true
    }
  ],
  "actions": [
    {
      "label": "Sign in",
      "on": "row",
      "rows": [
        "macbook-pro/npm"
      ],
      "id": "sign-in:macbook-pro/npm",
      "run": {
        "terminal": true,
        "argv": [
          "accounts"
        ]
      },
      "default": true,
      "busy": "Waiting",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Terminal"
          },
          {
            "kind": "text",
            "text": "station accounts on This Mac"
          }
        ]
      }
    },
    {
      "label": "Remove",
      "on": "row",
      "rows": [
        "linux-1/claude"
      ],
      "confirm": {
        "question": "Remove Claude? The grant ends here; the token stays yours.",
        "yes": "Remove"
      },
      "mutates": true,
      "id": "remove-grant:linux-1/claude",
      "run": {
        "call": "grants.remove",
        "in": {
          "Confirm": "yes",
          "Entry": "pw-claude",
          "To": "linux-1",
          "ToKind": "machine"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Claude removed from linux-1"
          }
        ]
      },
      "destructive": true
    },
    {
      "label": "Remove",
      "on": "row",
      "rows": [
        "linux-1/gh"
      ],
      "confirm": {
        "question": "Remove GitHub? The grant ends here; the token stays yours.",
        "yes": "Remove"
      },
      "mutates": true,
      "id": "remove-grant:linux-1/gh",
      "run": {
        "call": "grants.remove",
        "in": {
          "Confirm": "yes",
          "Entry": "pw-github",
          "To": "linux-1",
          "ToKind": "machine"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "GitHub removed from linux-1"
          }
        ]
      },
      "destructive": true
    },
    {
      "label": "Full list in Terminal",
      "on": "page",
      "priority": 2,
      "id": "full-list",
      "run": {
        "terminal": true,
        "argv": [
          "accounts",
          "--all-machines"
        ]
      },
      "icon": "arrow.up.forward"
    },
    {
      "label": "Grant a password",
      "on": "page",
      "mutates": true,
      "id": "grant",
      "run": {
        "call": "grants.add",
        "in": {
          "To": "linux-1",
          "ToKind": "machine"
        }
      },
      "form": {
        "title": "Grant a password",
        "fields": [
          {
            "key": "To",
            "label": "To",
            "kind": "select",
            "options": [
              {
                "value": "grant:linux-1",
                "label": "linux-1",
                "glyph": {
                  "kind": "workspace"
                }
              },
              {
                "value": "grant:agent-7f",
                "label": "agent-7f",
                "glyph": {
                  "kind": "workspace"
                }
              }
            ],
            "default": "grant:linux-1",
            "swaps": true
          },
          {
            "key": "Entry",
            "label": "Password",
            "kind": "pick",
            "options": [
              {
                "value": "pw-github",
                "label": "GitHub token",
                "note": "Granted already; granting again replaces it",
                "glyph": {
                  "kind": "account:github"
                }
              },
              {
                "value": "pw-claude",
                "label": "Claude token",
                "note": "Granted already; granting again replaces it",
                "glyph": {
                  "kind": "account:claude"
                }
              }
            ],
            "default": "pw-github",
            "required": true
          }
        ],
        "subtitle": "From the passwords of This Mac. It stays until you remove it. Touch ID will ask you to confirm before the password leaves this Mac.",
        "primary": [
          {
            "when": {
              "key": "Entry",
              "set": true
            },
            "label": "Grant {Entry}"
          }
        ]
      },
      "icon": "plus",
      "sheet": "grant",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Granted {Entry} to linux-1"
          }
        ]
      }
    },
    {
      "label": "Claude granted to linux-1",
      "on": "menu",
      "id": "title:linux-1/claude"
    },
    {
      "label": "Remove",
      "on": "menu",
      "confirm": {
        "question": "Remove Claude? The grant ends here; the token stays yours.",
        "yes": "Remove"
      },
      "mutates": true,
      "id": "remove-grant:linux-1/claude@menu",
      "run": {
        "call": "grants.remove",
        "in": {
          "Confirm": "yes",
          "Entry": "pw-claude",
          "To": "linux-1",
          "ToKind": "machine"
        }
      },
      "icon": "stop",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Claude removed from linux-1"
          }
        ]
      },
      "destructive": true
    },
    {
      "label": "GitHub granted to linux-1",
      "on": "menu",
      "id": "title:linux-1/gh"
    },
    {
      "label": "Remove",
      "on": "menu",
      "confirm": {
        "question": "Remove GitHub? The grant ends here; the token stays yours.",
        "yes": "Remove"
      },
      "mutates": true,
      "id": "remove-grant:linux-1/gh@menu",
      "run": {
        "call": "grants.remove",
        "in": {
          "Confirm": "yes",
          "Entry": "pw-github",
          "To": "linux-1",
          "ToKind": "machine"
        }
      },
      "icon": "stop",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "GitHub removed from linux-1"
          }
        ]
      },
      "destructive": true
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:key"
    }
  },
  "footer": {
    "kind": "terminal-list",
    "buttons": [
      "full-list",
      "grant"
    ]
  }
}
