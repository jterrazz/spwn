        }
      ],
      "card": "flush"
    },
    {
      "id": "on:review-bot",
      "title": "On review-bot",
      "caption": [
        {
          "kind": "text",
          "text": "1"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "review-bot/claude",
            "mark": "ok",
            "label": "Claude",
            "cells": [
              {
                "kind": "text",
                "text": "granted"
              }
            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "from the password Claude token"
                }
              ]
            },
            "glyph": {
              "kind": "account:claude"
            },
