                }
              ]
            },
            "reason": "refused",
            "glyph": {
              "kind": "symbol:key",
              "signal": "waits"
            },
            "verb": "sign-in:macbook-pro/npm"
          }
        }
      ],
      "uncounted": true,
      "card": "flush"
    },
    {
      "id": "on:macbook-pro",
      "title": "On This Mac",
      "caption": [
        {
          "kind": "text",
