# The repository's own ignores (node_modules, OS and editor junk, the
# archives) are at the root. This file carries what only this Next app
# produces.

# Build, test and lint artefacts (@jterrazz/typescript)
.artifacts/

# What a framework writes at a path it fixes itself: Next's ambient
# types, Tauri's generated platform scaffolding, and the HTTPS dev
# certificates `next dev --experimental-https` mints.
next-env.d.ts
src-tauri/gen/
*.pem

# Local environment
.env*
