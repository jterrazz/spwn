{
    "extends": ["//"],
    "tasks": {
        // The binary keeps the path the installer, goreleaser and every E2E
        // suite already expect, which means a `-o` flag, which means the
        // command is written out rather than inferred. Go's own inference
        // would drop it at apps/cli/spwn.
        "build": {
            "cache": true,
            "command": ["go", "build", "-o", "../../.artifacts/go/spwn", "./cmd/spwn"],
            "outputs": ["$TURBO_ROOT$/.artifacts/go/spwn"]
        },
        // invariant: cmd/gen-docs's tests compare the Cobra tree with two files outside this module, the generated
        // commands page and the cli specification's command words, so either one changing reruns them.
        "test": {
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/docs/reference/commands.md",
                "$TURBO_ROOT$/specs/cli/cli.specification.ts"
            ]
        }
    }
}
