{
    "name": "spwn:specs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "typescript check",
        "lint:fix": "typescript fix",
        "test:contracts": "node _contracts/assert-contracts.mjs",
        "test": "vitest --run",
        "test:watch": "vitest",
        "test:smoke": "vitest --run --config vitest.smoke.config.ts",
        "test:web": "npx playwright test --config web/playwright.config.ts",
        "test:web:headed": "npx playwright test --config web/playwright.config.ts --headed",
        "test:web:debug": "npx playwright test --config web/playwright.config.ts --debug"
    },
    "dependencies": {
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@hono/node-server": "^1.0.0",
        "@jterrazz/test": "^15.1.0",
        "@jterrazz/typescript": "^10.1.10",
        "@playwright/test": "^1.59.1",
        "@types/node": "^25.5.0",
        "hono": "^4.0.0",
        "vitest": "^4.1.10"
    }
}
