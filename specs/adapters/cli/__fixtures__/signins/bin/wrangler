#!/bin/sh
# A sign-in's lines as wrangler answers them with no terminal: signed out
# until $HOME/wrangler.in exists, and a login prints its link, then its code,
# then signs in.
printf 'wrangler %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "whoami --json")
        echo ' ⛅️ wrangler 4.162.0'
        if [ -f "$HOME/wrangler.in" ]; then echo '{"loggedIn":true,"email":"admin@jterrazz.com"}'; else echo '{"loggedIn":false}'; fi ;;
    "login --device")
        /bin/cat "$HOME/outputs/wrangler-login.txt"
        /bin/sleep 1
        /usr/bin/touch "$HOME/wrangler.in" ;;
    *) echo "stub wrangler: unexpected invocation: $*" >&2; exit 97 ;;
esac
