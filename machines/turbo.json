{
    "$schema": "https://turborepo.dev/schema.json",
    "agentGuidance": false,
    "futureFlags": {
        "experimentalGoWorkspaces": true
    },
    "cacheDir": ".artifacts/turbo",
    "tasks": {
        "//#lint": {
            "cache": false
        },
        "test": {},
        "specs#test": {
            "cache": false
        }
    },
    "globalPassThroughEnv": [
        "STATION_SPEC_BUILT",
        "STATION_SPEC_HYPERVISOR",
        "STATION_REQUIRE_MENUBAR",
        "STATION_WORLD",
        "TEST_UPDATE",
        "VITEST_MAX_WORKERS",
        "GOFLAGS",
        "GOOS"
    ]
}
