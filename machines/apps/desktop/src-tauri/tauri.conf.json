{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Spwn",
    "mainBinaryName": "spwn-window",
    "version": "0.1.0",
    "identifier": "com.jterrazz.spwn",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Spwn",
                "width": 1440,
                "height": 1000,
                "minWidth": 1100,
                "minHeight": 700,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": { "x": 18, "y": 25.5 },
                "theme": "Dark",
                "transparent": true,
                "windowEffects": {
                    "effects": ["underWindowBackground"],
                    "state": "followsWindowActiveState"
                }
            }
        ],
        "security": { "csp": "default-src 'self'; font-src 'self' data:; img-src 'self' data:" }
    },
    "bundle": {
        "active": true,
        "targets": ["app"],
        "icon": ["icons/icon.png", "icons/icon.icns"],
        "macOS": { "minimumSystemVersion": "26.0" }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDOTEzNzY4NzQ1QzEzNEMKUldSTUUxeDBhRGVSM0lGYk5FdlpyWU5sSHB1QzlXTTB3eFhWKzZYY1dZMmVlTDBtK3R5b2pTM3QK",
            "endpoints": ["https://github.com/jterrazz/spwn/releases/latest/download/latest.json"],
            "requireSignedVersion": true
        }
    }
}
