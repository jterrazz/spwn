#!/bin/sh
# dpkg-query: the packages of dpkg.db by their status, installed (ii) unless its third column says another (iF, half-configured), and one removed with its configuration kept (rc).
printf 'dpkg-query %s\n' "$*" >> "$HOME/.calls"
[ -f "$HOME/dpkg.db" ] && /usr/bin/awk -F'\t' '{ s = ($3 == "") ? "ii" : $3; printf "%s\t%s\t%s \n", $1, $2, s }' "$HOME/dpkg.db"
printf 'removed-kept\t1.0\trc \n'
