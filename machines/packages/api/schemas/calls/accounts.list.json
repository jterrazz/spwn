          ]
        },
        "Verdict": {
          "$ref": "#/$defs/core.verdict.Verdict"
        }
      },
      "required": [
        "Programs",
        "Verdict"
      ],
      "type": "object"
    },
    "accounts.calls.ProgramsIn": {
      "additionalProperties": false,
      "properties": {
