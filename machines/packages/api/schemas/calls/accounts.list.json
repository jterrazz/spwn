  "$id": "https://github.com/jterrazz/spwn/blob/main/machines/packages/api/schemas/calls/accounts.list.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The watch accounts.list of station.api/v2: the `in` its request frame carries, and the `out` of each answer. Written by make generate from the Go types the call reads and answers; the frames are frame.json.",
  "properties": {
    "in": {
      "$ref": "#/$defs/accounts.calls.ProgramsIn"
    },
