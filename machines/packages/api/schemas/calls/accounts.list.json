        },
        "EntryLabel": {
          "type": "string"
        },
        "How": {
          "enum": [
            "own",
            "granted"
          ],
          "type": "string"
        },
        "Line": {
          "type": "string"
        },
        "Plan": {
          "type": "string"
        },
        "Program": {
          "enum": [
