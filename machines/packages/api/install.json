{
  "line": "curl -fsSL https://spwn.sh/install.sh | bash",
  "dir": "~/.local/bin",
  "binary": "station",
  "bundled": "Contents/MacOS/Spwn Engine",
  "record": {
    "root": "state",
    "path": "station/engine.json",
    "schema": "station.engine-record/v1"
  },
  "installed": {
    "root": "state",
    "path": "station/installed.json",
    "schema": "station.install-record/v1"
  }
}
