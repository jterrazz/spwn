# pnpm's spelling of what the bun era wrote as `trustedDependencies`: the
# only packages whose install scripts may run. pnpm reads this at the
# workspace ROOT, and this workspace has no root package.json to carry a
# `pnpm.onlyBuiltDependencies` field, so the setting lives here.
only-built-dependencies[]=sharp
only-built-dependencies[]=unrs-resolver
