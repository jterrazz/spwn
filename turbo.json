{
    "$schema": "https://turborepo.dev/schema.json",
    "agentGuidance": false,
    // outside: `experimentalGoWorkspaces` reads go.work and turns every module into a package beside the pnpm
    // workspace's own; `experimentalTaskCommand` lets `lint` be golangci-lint instead of the `go vet` default.
    "futureFlags": {
        "experimentalGoWorkspaces": true,
        "experimentalTaskCommand": true
    },
    "cacheDir": ".artifacts/turbo",
    "tasks": {
        // hazard: no `^build` anywhere: spwn.sh/packages/world and spwn.sh/packages/transpile require each other,
        // which Go permits and Turborepo rejects as a cyclic task dependency; Go orders them itself through go.work.
        "build": {
            "dependsOn": ["dependency#generate"]
        },
        "lint": {
            "dependsOn": ["dependency#generate"],
            // outside: golangci-lint refuses to start beside itself unless `--allow-parallel-runners` is passed.
            "command": {
                "go": ["golangci-lint", "run", "--allow-parallel-runners", "./..."]
            },
            "env": ["GOLANGCI_VERSION"],
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.golangci.yml"]
        },
        // invariant: the TypeScript toolchain judges the whole repository at once (every member, the manual, the
        // names, the comments of every script), so its one run is the root's, and nothing it reads is cacheable.
        "//#lint": {
            "cache": false
        },
        "test": {
            "dependsOn": ["dependency#generate"]
        },
        // invariant: the cli and website specs drive the compiled binary at .artifacts/go/spwn.
        "spwn-specs#test": {
            "dependsOn": ["cli#build"],
            "cache": false
        }
    }
}
